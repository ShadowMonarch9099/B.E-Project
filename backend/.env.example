# Copy this file to backend/.env and fill in what you need. backend/.env is gitignored:
# never commit a real key. Variables already set in your shell take precedence.

# Answers: the Claude API (Anthropic). Without a key, detection, OCR, search and abstention
# still work, and the ask bar explains how to add one. The top 6 passages of each answered
# question are sent to the API (docs/Review2_Plan.md, section 16).
ANTHROPIC_API_KEY=
# SAKSHYA_LLM_MODEL=claude-opus-5-5
# SAKSHYA_LLM_EFFORT=medium            # low | medium | high | xhigh | max
# SAKSHYA_LLM_MAX_TOKENS=16000

# Query understanding (IndicLID, IndicXlit, translation). Translation uses IndicTrans2 when
# HF_TOKEN belongs to an account that accepted its terms on Hugging Face, otherwise NLLB-200.
# HF_TOKEN=
# SAKSHYA_TRANSLATOR=auto              # auto | indictrans2 | nllb | off
# SAKSHYA_MODEL_DIR=                   # default <data dir>/models (IndicLID, converted NLLB)

# Answer checks: NLI verification of each cited sentence (off by default; see app/ml/nli.py)
# SAKSHYA_NLI=off
# SAKSHYA_NLI_THRESHOLD=0.3

# Retrieval
# SAKSHYA_EMBED_MODEL=intfloat/multilingual-e5-base     # or intfloat/multilingual-e5-large
# SAKSHYA_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# SAKSHYA_TOP_K=40                     # candidates fused and reranked
# SAKSHYA_TOP_N=6                      # passages sent to the answer model
# SAKSHYA_GATE_TAU=0.15                # evidence gate: abstain below this reranker score

# Database (PostgreSQL 16 + pgvector). `docker compose up -d db` starts one on port 5433.
SAKSHYA_DATABASE_URL=postgresql+psycopg://sakshya:sakshya@localhost:5433/sakshya

# Where uploaded originals are stored (default: <repo>/data)
# SAKSHYA_DATA_DIR=

# Upload limit in MB; set the same value in the frontend's shell (default 200)
# SAKSHYA_MAX_FILE_MB=200

# OCR
# SAKSHYA_OCR_LANGS=mar+hin+eng
# SAKSHYA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# SAKSHYA_OCR_WORKERS=4

# DOCX -> PDF converter (found automatically if LibreOffice is installed)
# SAKSHYA_LIBREOFFICE_CMD=
