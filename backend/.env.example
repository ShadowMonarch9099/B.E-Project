# Copy this file to backend/.env and fill in what you need. backend/.env is gitignored:
# never commit a real key. Variables already set in your shell take precedence.

# Database (PostgreSQL 16 + pgvector). `docker compose up -d db` starts one on port 5433.
SAKSHYA_DATABASE_URL=postgresql+psycopg://sakshya:sakshya@localhost:5433/sakshya

# Where uploaded originals are stored (default: <repo>/data)
# SAKSHYA_DATA_DIR=

# Upload limit in MB; set the same value in the frontend's shell (default 200)
# SAKSHYA_MAX_FILE_MB=200

# OCR
# SAKSHYA_OCR_LANGS=mar+hin+eng
# SAKSHYA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# SAKSHYA_OCR_WORKERS=4

# DOCX -> PDF converter (found automatically if LibreOffice is installed)
# SAKSHYA_LIBREOFFICE_CMD=
